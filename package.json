{
	"name": "n8n-nodes-extralt",
	"version": "0.1.0",
	"description": "n8n nodes for Extralt: start workflows when Robots, Runs, Enrichments and Imports finish",
	"license": "MIT",
	"homepage": "https://extralt.com",
	"keywords": [
		"n8n-community-node-package",
		"extralt",
		"ecommerce",
		"product-data",
		"web-scraping",
		"price-monitoring"
	],
	"author": {
		"name": "Extralt",
		"email": "support@extralt.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extralt-ai/n8n-nodes-extralt.git"
	},
	"bugs": "https://github.com/extralt-ai/n8n-nodes-extralt/issues",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"check": "prettier --check . && npm run lint && npm run typecheck && npm test && npm run build",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ExtraltApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ExtraltTrigger/ExtraltTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.1",
		"@types/node": "22.20.5",
		"eslint": "9.29.0",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"vitest": "5.0.3"
	}
}
